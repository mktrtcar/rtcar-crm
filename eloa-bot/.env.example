# Copie este arquivo para ".env" (mesma pasta) e preencha com suas chaves reais.
# O ".env" nunca é enviado pro GitHub (está no .gitignore).

# Obrigatório para a Eloá conversar (Google AI Studio: https://aistudio.google.com/apikey)
GOOGLE_AI_API_KEY=

# Opcional — chave separada (projeto Google Cloud diferente) só pra testes, sem gastar a cota
# da chave de produção acima. Usada automaticamente por simular.js/testar-conversa.js.
GOOGLE_AI_API_KEY_TESTE=

# claude.js (motor de texto Claude, ainda não ligado em produção — ver claude.js/README.md)
# Console: https://console.anthropic.com — Billing (créditos) + API Keys
ANTHROPIC_API_KEY=

# Opcional — só se quiser nota de voz em vez de texto nas respostas da conversa
ELOA_MODO_VOZ=false
# "cartesia", "gemini", "fish" ou "pocket" (Gemini usa a mesma GOOGLE_AI_API_KEY acima, voz "Kore")
ELOA_VOZ_PROVEDOR=

# Só necessárias se ELOA_VOZ_PROVEDOR=cartesia
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Só necessárias se ELOA_VOZ_PROVEDOR=fish (https://fish.audio)
FISH_API_KEY=
# Opcional — id de voz clonada/customizada; sem isso usa a voz padrão do modelo
FISH_VOICE_ID=

# Só necessárias se ELOA_VOZ_PROVEDOR=pocket — precisa do servidor local rodando
# (ver eloa-bot/pocket-tts/README.md)
POCKET_TTS_BASE_URL=http://localhost:8000
POCKET_VOZ=rafael
