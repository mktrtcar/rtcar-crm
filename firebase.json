{
  "functions": [
    {
      "source": "webhook-autoconf",
      "codebase": "default",
      "runtime": "nodejs22"
    }
  ],
  "hosting": [
    {
      "target": "painel-eva",
      "public": "painel-eva",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },
    {
      "target": "crm-staging",
      "public": "crm-staging-hosting",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "**",
          "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]
        }
      ]
    }
  ]
}
