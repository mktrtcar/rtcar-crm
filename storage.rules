rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Banner do site publico (site-publico/) - fotos de capa que a Aline
    // sobe pelo admin.html. Leitura publica (o site precisa mostrar sem
    // login), escrita só logada - mesmo padrao "login obrigatorio pra
    // escrever" usado no Firestore do resto do projeto. Nao mexe em nada
    // do Firestore, arquivo isolado so pra Storage.
    match /banners/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
